# Arynox AI - environment template
# Copy to .env and fill in real keys (see project docs).

GROQ_API_KEY=
EXA_API_KEY=
CEREBRAS_API_KEY=
OPENCODE_API_KEY=

# Supabase (auth + future database) - https://supabase.com dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server-side only, never expose in client code
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=       # same as SUPABASE_URL (client bundle)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp Business Cloud API (optional, for the WhatsApp bot)
# Get from https://developers.facebook.com/apps > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Frontend-only deployment (Vercel): proxy all /api/* calls to the backend host (Render)
# Set ONLY on the frontend host. Leave unset on the backend host.
API_ORIGIN=https://arynox-ai.onrender.com
